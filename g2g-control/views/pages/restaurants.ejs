<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>G2G | Dashboard</title>
    <meta content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no' name='viewport'>
    <!-- Bootstrap 3.3.2 -->
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" />    
    <!-- FontAwesome 4.3.0 -->
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.3.0/css/font-awesome.min.css" rel="stylesheet" type="text/css" />
    <!-- Ionicons 2.0.0 -->
    <link href="http://code.ionicframework.com/ionicons/2.0.0/css/ionicons.min.css" rel="stylesheet" type="text/css" />    
    <!-- Theme style -->
    <link href="/dist/css/AdminLTE.min.css" rel="stylesheet" type="text/css" />
    <!-- AdminLTE Skins. Choose a skin from the css/skins 
         folder instead of downloading all of them to reduce the load. -->
    <link href="/dist/css/skins/_all-skins.min.css" rel="stylesheet" type="text/css" />
    <!-- iCheck -->
    <link href="/plugins/iCheck/flat/blue.css" rel="stylesheet" type="text/css" />
    <!-- Morris chart -->
    <!-- <link href="/plugins/morris/morris.css" rel="stylesheet" type="text/css" /> -->
    <!-- jvectormap -->
    <!-- <link href="/plugins/jvectormap/jquery-jvectormap-1.2.2.css" rel="stylesheet" type="text/css" /> -->
    <!-- Date Picker -->
    <!-- <link href="/plugins/datepicker/datepicker3.css" rel="stylesheet" type="text/css" /> -->
    <!-- Daterange picker -->
    <!-- <link href="/plugins/daterangepicker/daterangepicker-bs3.css" rel="stylesheet" type="text/css" /> -->
    <!-- bootstrap wysihtml5 - text editor -->
    <link href="/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.min.css" rel="stylesheet" type="text/css" />
 	<!-- DATA TABLES -->
    <link href="../../plugins/datatables/dataTables.bootstrap.css" rel="stylesheet" type="text/css" />
	<!-- g2g stylesheet -->
    <link href="/g2g/css/g2g.css" rel="stylesheet" type="text/css" />
    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
        <script src="https://oss.maxcdn.com/libs/respond.js/1.3.0/respond.min.js"></script>
    <![endif]-->
  </head>
  <body ng-app="G2GControlCenterApplication" class="skin-blue">
    <div class="wrapper">
      
      <header class="main-header">
        <% include ../partials/header %>
      </header>
      
      <!-- Left side column. contains the logo and sidebar -->
      <aside class="main-sidebar">
       <% include ../partials/side %>
      </aside>

      <!-- Contains the navbar and content of the page -->
      <div class="content-wrapper" ng-controller="RestaurantsPageContentController">
        <!-- Content Header (Page header) -->
        <section class="content-header">
          <h1>
            G2G Dashboard
            <small>Restaurants</small>
          </h1>
          <ol class="breadcrumb">
            <li><a href="home"><i class="fa fa-dashboard"></i> Home</a></li>
          </ol>
        </section>
        <!-- Main content -->
        <section class="content">
          <!-- Small boxes (Stat box) -->
          <div class="box">
                <div class="box-header">
                  <h3 class="box-title">Restaurants</h3>
                </div><!-- /.box-header -->
                <div class="box-body">
				<div class="overlay"  ng-show="loading == true">
                  <i class="fa fa-refresh fa-spin"></i>
                </div>
                <div class="box-body table-responsive no-padding"  ng-show="loading == false">
                  <table id="restaurantsTable" class="table table-bordered table-striped">
                    <thead>
                      <tr>
                        <th>Name</th>
                        <th>Location</th>
                        <th>Cuisine</th>
                        <th>Order</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr ng-repeat="restaurant in restaurants">
                        <td ng-bind="restaurant.name"></td>
                        <td ng-bind="restaurant.location"></td>
                        <td ng-bind="restaurant.cuisine"></td>
                        <td ng-bind="restaurant.order"></td>
                        <td><a href="categories#?restaurantId={{restaurant.id}}&restaurantName={{restaurant.name}}">Categories</a></td>
                        <td><a href="zip-codes#?restaurantId={{restaurant.id}}&restaurantName={{restaurant.name}}">Zip Codes</a></td>
                        <td><i class="fa fa-edit cursor" ng-click="openEditDialog(restaurant.id)"> Edit</i></td>
                        <td>
                        	<i class="ion-ios-pause cursor" ng-show="restaurant.active==true" ng-click="toggleActivation(restaurant.id)"> Deactivate</i>
                        	<i class="ion-ios-play cursor" ng-show="restaurant.active==false" ng-click="toggleActivation(restaurant.id)"> Activate</i>
							<i class="fa fa-refresh fa-spin" ng-show="saving==true && currentId == restaurant.id"></i>
                        </td>
                        <td><a href="#" ng-click="exportRestaurantItems(restaurant.id)">Export items</a></td>
                      </tr>
                    </tbody>
					<tfooter>
                      <tr>
                        <td colspan="8"><button type="button" class="btn btn-primary pull-right" data-toggle="modal" data-target="#addRestaurantModal">Add Restaurant</button></td>
                      </tr>
                    </tfooter>
                   </table>
					</div>
                </div><!-- /.box-body -->
              </div><!-- /.box -->
          <!-- Main row -->
          <div class="row">
		
		<!-- MODALS -->
        
		<div class="modal fade" id="addRestaurantModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
		  <div class="modal-dialog">
		    <div class="modal-content">
		      <div class="modal-header">
		        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
		        <h4 class="modal-title" id="myModalLabel">New Restaurant</h4>
		      </div>
		      <div class="modal-body">
		      	<div class="callout callout-danger" ng-show="serverError==true">
		             <h4>Saving failed!</h4>
		             <p>{{serverErrorMessage}}</p>
		         </div>
		        <form role="form" id="newRestaurantForm">
	                  <div class="box-body">
						<div class="overlay" ng-show="saving == true">
                  			<i class="fa fa-refresh fa-spin"></i>
                		</div>
	                  	<div class="form-group" ng-show="saving==false">
	                  		<div class="nav-tabs-custom">
	               				<ul class="nav nav-tabs">
	                  				<li class="active"><a href="#infoTab" data-toggle="tab">Info</a></li>
	                  				<li><a href="#workingHoursTab" data-toggle="tab">Working Hours</a></li>
	                  				<li><a href="#logoTab" data-toggle="tab">Logo</a></li>
	                			</ul>
	                			<div class="tab-content">
	                  				<div class="tab-pane active" id="infoTab">
	                  					<label class="control-label text-red" for="restaurantName" ng-show="restaurantNameMissing==true"><i class="fa fa-times-circle-o"></i>Name is missing</label>
	  			                    	<label for="restaurantName" ng-show="restaurantNameMissing==false">Name</label>
	            			          	<input type="text" required class="form-control" id="restaurantName" ng-model="newRestaurant.name" placeholder="Enter name" required>
							
										<label class="control-label text-red" for="restaurantLocation" ng-show="restaurantLocationMissing==true"><i class="fa fa-times-circle-o"></i>Location is missing</label>
				                      	<label for="restaurantLocation" ng-show="restaurantLocationMissing==false">Location</label>
				                      	<input type="text" required class="form-control" id="restaurantLocation" ng-model="newRestaurant.location" placeholder="Enter location" required>
							
										<label class="control-label text-red" for="restaurantCuisine" ng-show="restaurantCuisineMissing==true"><i class="fa fa-times-circle-o"></i>Cuisine is missing</label>
				                      	<label for="restaurantCuisine" ng-show="restaurantCuisineMissing==false">Cuisine</label>
				                      	<input type="text" required class="form-control" id="restaurantCuisine" ng-model="newRestaurant.cuisine" placeholder="Enter cuisine" required>
							
										<label class="control-label text-red" for="restaurantStreetAddress" ng-show="restaurantStreetAddressMissing==true"><i class="fa fa-times-circle-o"></i>Street Address is missing</label>
				                      	<label for="restaurantStreetAddress" ng-show="restaurantStreetAddressMissing==false">Street Address</label>
				                      	<input type="text" required class="form-control" id="restaurantStreetAddress" ng-model="newRestaurant.streetAddress" placeholder="Enter street address" required>
							
										<label class="control-label text-red" for="restaurantCity" ng-show="restaurantCityMissing==true"><i class="fa fa-times-circle-o"></i>City is missing</label>
				                      	<label for="restaurantCity" ng-show="restaurantCityMissing==false">City</label>
				                      	<input type="text" required class="form-control" id="restaurantCity" ng-model="newRestaurant.city" placeholder="Enter city" required>
							
										<label class="control-label text-red" for="restaurantState" ng-show="restaurantStateMissing==true"><i class="fa fa-times-circle-o"></i>State is missing</label>
				                      	<label for="restaurantState" ng-show="restaurantStateMissing==false">State</label>
				                      	<input type="text" required class="form-control" id="restaurantState" ng-model="newRestaurant.state" placeholder="Enter state" required>
							
										<label class="control-label text-red" for="restaurantZipCode" ng-show="restaurantZipCodeMissing==true"><i class="fa fa-times-circle-o"></i>Zip code is missing</label>
				                      	<label for="restaurantZipCode" ng-show="restaurantZipCodeMissing==false">Zip Code</label>
				                      	<input type="text" required class="form-control" id="restaurantZipCode" ng-model="newRestaurant.zipCode" placeholder="Enter zip code" required>
				                      	
				                      	<label for="restaurantOrder">Order</label>
				                      	<input type="number" required class="form-control" id="restaurantOrder" ng-model="newRestaurant.order" placeholder="Enter order" required>
	                      	
				                      	<div>
						                    <input id="restaurantPartner" type="checkbox" ng-model="newRestaurant.partner"></input>
				                       		<label for="restaurantPartner">Partner Restaurant ?</label>
				                      	</div>
				                    	<label class="control-label text-red" for="restaurantDeliveryCharge" ng-show="restaurantDeliveryChargeMissing==true && newRestaurant.partner==true"><i class="fa fa-times-circle-o"></i>Delivery charge for partner restaurants is required</label>
				                  		<label for="restaurantDeliveryCharge" ng-show="restaurantDeliveryChargeMissing==false  && newRestaurant.partner==true">Delivery Charge</label>
				                  		<input type="text" required class="form-control" id="restaurantDeliveryCharge" ng-model="newRestaurant.deliveryCharge" ng-show="newRestaurant.partner==true" placeholder="Enter delivery charge" required>
	                  				</div>
	                  				<div class="tab-pane" id="workingHoursTab">
				                      	<label for="sunday">Sunday</label>
				                      	<input type="text" required class="form-control" id="sunday" ng-model="sundayWorkingHours" placeholder="0000-0000" required>
				                      	<label for="monday">Monday</label>
				                      	<input type="text" required class="form-control" id="monday" ng-model="mondayWorkingHours" placeholder="1000-0300" required>
				                      	<label for="tuesday">Tuesday</label>
				                      	<input type="text" required class="form-control" id="tuesday" ng-model="tuesdayWorkingHours" placeholder="1000-0300" required>
				                      	<label for="wednesday">Wednesday</label>
				                      	<input type="text" required class="form-control" id="wednesday" ng-model="wednesdayWorkingHours" placeholder="1000-0300" required>
				                      	<label for="thursday">Thursday</label>
				                      	<input type="text" required class="form-control" id="thursday" ng-model="thursdayWorkingHours" placeholder="1000-0300" required>
				                      	<label for="friday">Friday</label>
				                      	<input type="text" required class="form-control" id="friday" ng-model="fridayWorkingHours" placeholder="1000-0300" required>
				                      	<label for="saturday">Saturday</label>
				                      	<input type="text" required class="form-control" id="saturday" ng-model="saturdayWorkingHours" placeholder="0000-0000" required>
	                  				</div>
	                  				<div class="tab-pane" id="logoTab">
	                  					<label for="logo">Logo - use <a href="http://www.base64-image.de/" target="_blank">this</a> to convert an image into base-64</label>
				                      	<input type="text" required class="form-control" id="logo" ng-model="newRestaurant.logo" placeholder="Base-64 of the logo - 48X48 .png image" required>
	                  				</div>
								</div>
							</div>
	                    </div><!-- /.form group -->
	                  </div><!-- /.box-body -->
	                </form>
		      </div>
		      <div class="modal-footer">
		        <button type="button" class="btn btn-default pull-left" data-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-primary" ng-click="addRestaurant(true)" ng-show="editMode==false">Save and close</button>
		        <button type="button" class="btn btn-primary" ng-click="addRestaurant(false)" ng-show="editMode==false">Save and add another</button>
		        <button type="button" class="btn btn-primary" ng-click="editRestaurant()" ng-show="editMode==true">Save</button>
		      </div>
		    </div>
		  </div>
		</div>
        <!-- MODALS END -->

          </div><!-- /.row (main row) -->
		</div>
        </section><!-- /.content -->
      </div><!-- /.content-wrapper -->
      
      <footer class="main-footer">
        <% include ../partials/footer %>
      </footer>
    </div><!-- ./wrapper -->

    <!-- jQuery 2.1.3 -->
    <script src="/plugins/jQuery/jQuery-2.1.3.min.js"></script>
    <!-- jQuery UI 1.11.2 -->
    <script src="http://code.jquery.com/ui/1.11.2/jquery-ui.min.js" type="text/javascript"></script>
    <!-- Resolve conflict in jQuery UI tooltip with Bootstrap tooltip -->
    <script>
      $.widget.bridge('uibutton', $.ui.button);
    </script>
    <!-- Bootstrap 3.3.2 JS -->
    <script src="/bootstrap/js/bootstrap.min.js" type="text/javascript"></script>    
    <!-- Morris.js charts -->
    <!-- <script src="http://cdnjs.cloudflare.com/ajax/libs/raphael/2.1.0/raphael-min.js"></script> -->
    <!-- <script src="/plugins/morris/morris.min.js" type="text/javascript"></script> -->
    <!-- Sparkline -->
    <!-- <script src="/plugins/sparkline/jquery.sparkline.min.js" type="text/javascript"></script> -->
    <!-- jvectormap -->
    <!-- <script src="/plugins/jvectormap/jquery-jvectormap-1.2.2.min.js" type="text/javascript"></script> -->
    <!-- <script src="/plugins/jvectormap/jquery-jvectormap-world-mill-en.js" type="text/javascript"></script> -->
    <!-- jQuery Knob Chart -->
    <!-- <script src="/plugins/knob/jquery.knob.js" type="text/javascript"></script> -->
    <!-- daterangepicker -->
    <!-- <script src="/plugins/daterangepicker/daterangepicker.js" type="text/javascript"></script> -->
    <!-- datepicker -->
    <!-- <script src="/plugins/datepicker/bootstrap-datepicker.js" type="text/javascript"></script> -->
    <!-- Bootstrap WYSIHTML5 -->
    <script src="/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.all.min.js" type="text/javascript"></script>
    <!-- iCheck -->
    <script src="/plugins/iCheck/icheck.min.js" type="text/javascript"></script>
    <!-- Slimscroll -->
    <script src="/plugins/slimScroll/jquery.slimscroll.min.js" type="text/javascript"></script>
    <!-- FastClick -->
    <script src='/plugins/fastclick/fastclick.min.js'></script>
    <!-- AdminLTE App -->
    <script src="/dist/js/app.min.js" type="text/javascript"></script>

    <!-- AdminLTE dashboard demo (This is only for demo purposes) -->
    <!-- <script src="/dist/js/pages/dashboard.js" type="text/javascript"></script> -->

    <!-- AdminLTE for demo purposes -->
    <!-- <script src="/dist/js/demo.js" type="text/javascript"></script> -->
    <!-- DATA TABES SCRIPT -->
    <script src="../../plugins/datatables/jquery.dataTables.js" type="text/javascript"></script>
    <script src="../../plugins/datatables/dataTables.bootstrap.js" type="text/javascript"></script>
    <!-- angular js library and g2g angular js controllers -->
    <script src="http://ajax.googleapis.com/ajax/libs/angularjs/1.2.26/angular.min.js"></script>
    <script src="/g2g/js/G2GControlCenterApplication.js" type="text/javascript"></script>
    <script src="/g2g/js/RestaurantsPageContentController.js" type="text/javascript"></script>   
    <script src="/g2g/js/HeaderContentController.js" type="text/javascript"></script> 
  </body>
</html>