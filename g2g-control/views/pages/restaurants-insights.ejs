          </ol>
        </section>

        <!-- Main content -->
        <section class="content">
          <div class="row">
          
          	 <!-- BAR CHART -->
              <div class="box box-success">
                <div class="box-header">
                  <h3 class="box-title">Restaurants</h3>
                </div>
                <div class="box-body">
                  <canvas id="barChart" height="230"></canvas>
                </div><!-- /.box-body -->
              </div><!-- /.box -->
          
          </div><!-- /.row -->
          <!-- Main row -->
          <div class="row">
        </section><!-- /.content -->
