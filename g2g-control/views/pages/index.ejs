          <!-- MODALS -->
        
		<div class="modal fade" id="orderDetailsModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
		  <div class="modal-dialog">
		    <div class="modal-content">
		      <div class="modal-header">
		        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
		        <h4 class="modal-title" id="myModalLabel">Order Details</h4>
		      </div>
		      <div class="modal-body">
		        <form role="form" id="orderForm">
                <div class="box-body">
					<div class="overlay" ng-show="loading == true">
                 		<i class="fa fa-refresh fa-spin"></i>
               		</div>
	               <div class="nav-tabs-custom">
	                <ul class="nav nav-tabs">
	                  <li class="active"><a href="#orderTab" data-toggle="tab">Order</a></li>
	                  <li><a href="#customerTab" data-toggle="tab">Customer</a></li>
	                  <li><a href="#restaurantTab" data-toggle="tab">Restaurant</a></li>
	                  <li><a href="#costTab" data-toggle="tab">Cost</a></li>
	                  <li><a href="#itemsTab" data-toggle="tab">Items</a></li>
	                  <li ng-show="currentOrder.appVersion >= 2.5"><a href="#trackingTab" data-toggle="tab">Tracking</a></li>
	                </ul>
	                <div class="tab-content">
	                  <div class="tab-pane active" id="orderTab">
	                    <div>
							<label for="id">ID</label>
							<input type="text" disabled class="form-control" id="id" ng-model="currentOrder.id">
							<label for="status">Status</label>
							<input type="text" disabled class="form-control" id="status" ng-model="currentOrder.status">
							<label for="placed">Placed</label>
							<input type="text" disabled class="form-control" id="placed" ng-model="currentOrder.placedAt">
							<label for="pickedUp">Picked Up</label>
							<input type="text" disabled class="form-control" id="pickedUp" ng-model="currentOrder.pickedUpAt">
							<label for="deliveredAt">Delivered</label>
							<input type="text" disabled class="form-control" id="delivered" ng-model="currentOrder.deliveredAt">
							<label for="driver">Driver</label>
							<input type="text" disabled class="form-control" id="driver" ng-model="currentOrder.driver.fullName">
						</div>
	                  </div><!-- /.tab-pane -->
	                  <div class="tab-pane" id="customerTab">
	                  	<div>
							<label for="customer">Customer</label>
							<input type="text" disabled class="form-control" id="customer" ng-model="currentOrder.deliveryUserFullName">
							<label for="phone">Phone</label>
							<input type="text" class="form-control" id="phone" ng-model="currentOrder.deliveryUserPhone">
							<label for="email">Email</label>
							<input type="text" class="form-control" id="email" ng-model="currentOrder.deliveryUserEmail">
							<label for="streetAddress1">Street Address 1</label>
							<input type="text" class="form-control" id="streetAddress1" ng-model="currentOrder.deliveryStreetAddress1">
							<label for="streetAddress2">Street Address 2</label>
							<input type="text" class="form-control" id="streetAddress2" ng-model="currentOrder.deliveryStreetAddress2">
							<label for="city">City</label>
							<input type="text" class="form-control" id="city" ng-model="currentOrder.deliveryCity">
							<label for="zipCode">Zip Code</label>
							<input type="text" class="form-control" id="zipCode" ng-model="currentOrder.deliveryZipCode">
							<label for="specialInstructions">Special Instructions</label>
							<input type="text" class="form-control" id="specialInstructions" ng-model="currentOrder.specialInstructions">
						</div>
	                  </div><!-- /.tab-pane -->
	                  <div class="tab-pane" id="restaurantTab">
	                  	<div>
							<label for="restaurant">Restaurant</label>
							<input type="text" disabled class="form-control" id="restaurant" ng-model="currentOrder.restaurant.name">
							<label for="restaurantAddress">Restaurant Address</label>
							<input type="text" class="form-control" id="restaurantAddress" ng-model="currentOrder.restaurantStreetAddress">
							<label for="restaurantCity">Restaurant City</label>
							<input type="text" class="form-control" id="restaurantCity" ng-model="currentOrder.restaurantCity">
							<label for="restaurantZipCode">Restaurant Zip Code</label>
							<input type="text" class="form-control" id="restaurantZipCode" ng-model="currentOrder.restaurantZipCode">
						</div>
	                  </div><!-- /.tab-pane -->
	                  <div class="tab-pane" id="costTab">
	                  	<div>
							<label for="value">Value</label>
							<input type="text" disabled class="form-control" id="value" ng-model="currentOrder.value">
							<label for="tax">Tax</label>
							<input type="text" disabled class="form-control" id="tax" ng-model="currentOrder.tax">
							<label for="deliveryCharge">Delivery charge</label>
							<input type="text" disabled class="form-control" id="deliveryCharge" ng-model="currentOrder.deliveryCharge">
							<label for="dicsounts">Discounts</label>
							<input type="text" disabled class="form-control" id="discounts" ng-model="currentOrder.discounts">
							<label for="tips">Tips</label>
							<input type="text" disabled class="form-control" id="tips" ng-model="currentOrder.tipsAmount">
							<label for="total">Total</label>
							<input type="text" disabled class="form-control" id="total" ng-model="currentOrder.totalWithTips">
							
							<button type="button" class="btn btn-primary" ng-show="currentOrder.status!='REFUNDED'" ng-click="openRefundOrder(currentOrder)">Refund</button>
						</div>
	                  </div><!-- /.tab-pane -->
	                  <div class="tab-pane" id="itemsTab">
				<table id="itemsTable" class="table table-bordered table-hover">
                    <thead>
                      <tr>
                        <th>Item</th>
                        <th>In Category</th>
                        <th>Quantity</th>
                        <th>Price</th>
						<th>Sides</th>
                        <th>Special Instructions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr ng-repeat="item in currentOrder.items">
                        <td ng-bind="item.name">
                        </td>
                        <td ng-bind="item.categoryName">
                        </td>
                        <td ng-bind="item.quantity">
                        </td>
                        <td  ng-bind="item.price">
						</td>
						<td ng-bind="item.sides">
                        </td>
                        <td ng-bind="item.specialInstructions">
                        </td>
                      </tr>
                    </tbody>
                  </table>
	                  </div><!-- /.tab-pane -->
	                  <div class="tab-pane" id="trackingTab">
	                  	<div>
	                  		<label>Order placed using G2G mobile application version</label>
							<input type="text" disabled class="form-control" ng-model="currentOrder.appVersion">
							<label>ETA</label>
							<input type="text" disabled class="form-control" ng-model="currentOrder.eta">
							<label>Remaining Time</label>
							<input type="text" disabled class="form-control" ng-model="currentOrder.remainingTime">
							<a ng-click="showAddMoreTimeDialog()" href="#">Add More Time</a>
							<br/>
							<label ng-show="currentOrder.onTime == 0"><input type="checkbox" disabled checked>Order is late</label>
							<label ng-show="currentOrder.onTime == 1"><input type="checkbox" disabled>Order is late</label>
							<br/>
							<label ng-show="currentOrder.onTime == false">Message</label>
							<input type="text" ng-show="currentOrder.onTime == false" disabled class="form-control" ng-model="currentOrder.etaMessage">
						</div>
	                  </div><!-- /.tab-pane -->
	                </div><!-- /.tab-content -->
	              </div><!-- nav-tabs-custom -->
                </div><!-- /.box-body -->
              </form>
		      </div>
		      <div class="modal-footer">
		        <button class="btn btn-default pull-left" data-dismiss="modal">Close</button>
		      </div>
		    </div>
		  </div>
		</div>
		
		<div class="modal fade" id="addMoreTime" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
		  <div class="modal-dialog">
		    <div class="modal-content">
		      <div class="modal-header">
		        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
		        <h4 class="modal-title" id="addMoreTimeLabel">Add more time to this order's ETA</h4>
	      		<div class="overlay pull-right" ng-show="loading == true">
             		<i class="fa fa-refresh fa-spin"></i>
           		</div>
		      </div>
				<div class="callout callout-danger" ng-show="serverError==true">
		             <h4>Adding more time failed!</h4>
		             <p>{{serverErrorMessage}}</p>
		         </div>
		      <div class="modal-body">
		        <form role="form" id="addMoreTimeForm">
                <div class="box-body">
					<label for="minutes">Minutes to add to the currently remaining time</label>
					<input type="text" class="form-control" id="minutes" ng-model="moreTime.minutes"/>
					<label for="reason">Reason</label>
					<input type="text" class="form-control" id="reason" ng-model="moreTime.reason"></input>
                </div><!-- /.box-body -->
              </form>
		      </div>
		      <div class="modal-footer">
		        <button type="button" class="btn btn-default pull-left" data-dismiss="modal">Close</button>
				<button type="button" class="btn btn-primary" ng-click="submitAddMoreTime()" >Submit</button>
		      </div>
		    </div>
		  </div>
		</div>
		
		<div class="modal fade" id="refundOrderDialog" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
		  <div class="modal-dialog">
		    <div class="modal-content">
		      <div class="modal-header">
		        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
		        <h4 class="modal-title" id="sendDriverSMSLabel">Refund an order</h4>
	      		<div class="overlay pull-right" ng-show="loading == true">
             		<i class="fa fa-refresh fa-spin"></i>
           		</div>
		      </div>
				<div class="callout callout-danger" ng-show="serverError==true">
		             <h4>Refund failed!</h4>
		             <p>{{serverErrorMessage}}</p>
		         </div>
		      <div class="modal-body">
		        <form role="form" id="refundForm">
                <div class="box-body">
					<label for="refundReasonSelect">Refund Reason</label>
                	<select class="form-control" ng-model="refundReason" id="refundReasonSelect">
						<option value="The restaurant has closed">Restaurant Closed</option> 
						<option value="G2G is experiencing a shortage in drivers in your area">Drivers Shortage</option> 
						<option value="">Other</option>  
		            </select>
					<label for="refundReason">This text will appear to the user on the mobile app</label>
					<input type="text" class="form-control" id="refundReason" ng-model="refundReason"/>
                </div><!-- /.box-body -->
              </form>
		      </div>
		      <div class="modal-footer">
		        <button type="button" class="btn btn-default pull-left" data-dismiss="modal">Close</button>
				<button type="button" class="btn btn-primary" ng-click="refundOrder()" >Refund</button>
		      </div>
		    </div>
		  </div>
		</div>
		
		<div class="modal fade" id="sendDriverSMS" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
		  <div class="modal-dialog">
		    <div class="modal-content">
		      <div class="modal-header">
		        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
		        <h4 class="modal-title" id="sendDriverSMSLabel">Send SMS to Driver</h4>
	      		<div class="overlay pull-right" ng-show="sendingSMS == true">
             		<i class="fa fa-refresh fa-spin"></i>
           		</div>
		      </div>
				<div class="callout callout-danger" ng-show="serverError==true">
		             <h4>Sending SMS failed!</h4>
		             <p>{{serverErrorMessage}}</p>
		         </div>
		      <div class="modal-body">
		        <form role="form" id="smsForm">
                <div class="box-body">
					<label for="mobileNumber">Mobile Number (Add the country code in the beginning (1 for USA), if it is not added)</label>
					<input type="text" class="form-control" id="mobileNumber" ng-model="currentDriver.phone"/>
					<label for="sms">SMS</label>
					<textarea class="form-control" id="sms" ng-model="sms"></textarea>
                </div><!-- /.box-body -->
              </form>
		      </div>
		      <div class="modal-footer">
		        <button type="button" class="btn btn-default pull-left" data-dismiss="modal">Close</button>
				<button type="button" class="btn btn-primary" ng-click="sendSMS()" >Send</button>
		      </div>
		    </div>
		  </div>
		</div>
		
		<div class="modal fade" id="sendCustomerSMS" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
		  <div class="modal-dialog">
		    <div class="modal-content">
		      <div class="modal-header">
		        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
		        <h4 class="modal-title" id="sendCustomerSMSLabel">Send SMS to Customer</h4>
	      		<div class="overlay pull-right" ng-show="sendingSMS == true">
             		<i class="fa fa-refresh fa-spin"></i>
           		</div>
		      </div>
				<div class="callout callout-danger" ng-show="serverError==true">
		             <h4>Sending SMS failed!</h4>
		             <p>{{serverErrorMessage}}</p>
		         </div>
		      <div class="modal-body">
		        <form role="form" id="smsForm">
                <div class="box-body">
					<label for="mobileNumber">Mobile Number</label>
					<input type="text" class="form-control" id="mobileNumber" ng-model="currentOrder.deliveryUserPhone"/>
					<label for="sms">SMS</label>
					<textarea class="form-control" id="sms" ng-model="sms"></textarea>
                </div><!-- /.box-body -->
              </form>
		      </div>
		      <div class="modal-footer">
		        <button type="button" class="btn btn-default pull-left" data-dismiss="modal">Close</button>
				<button type="button" class="btn btn-primary" ng-click="sendSMSToCustomer()" >Send</button>
		      </div>
		    </div>
		  </div>
		</div>
		
		
		<div class="modal fade" id="updateRestaurantAddressrModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
		  <div class="modal-dialog">
		    <div class="modal-content">
		      <div class="modal-header">
		        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
		        <h4 class="modal-title" id="myModalLabel">Assign Driver</h4>
		      </div>
				<div class="callout callout-danger" ng-show="serverError==true">
		             <h4>Assigning failed!</h4>
		             <p>{{serverErrorMessage}}</p>
		         </div>
		      <div class="modal-body">
		        <form role="form" id="orderForm">
                <div class="box-body">
					<div class="overlay" ng-show="loading == true">
                 		<i class="fa fa-refresh fa-spin"></i>
               		</div>
					<div>
						<label for="newRestaurantAddress">Restaurant Address</label>
						<input type="text" class="form-control" id="newRestaurantAddress" ng-model="newRestaurantStreetAddress">
						<label for="newRestaurantCity">Restaurant City</label>
						<input type="text" class="form-control" id="newRestaurantCity" ng-model="newRestaurantCity">
						<label for="newRestaurantZipCode">Restaurant Zip Code</label>
						<input type="text" class="form-control" id="newRestaurantZipCode" ng-model="newRestaurantZipCode">
					</div>
                </div><!-- /.box-body -->
              </form>
		      </div>
		      <div class="modal-footer">
		        <button type="button" class="btn btn-default pull-left" data-dismiss="modal">Close</button>
		        <button type="button" class="btn btn-primary" ng-click="skipUpdateRestaurantAddress()" >Skip</button>
				<button type="button" class="btn btn-primary" ng-click="updateRestaurantAddress()" >Update</button>
		      </div>
		    </div>
		  </div>
		</div>


		<div class="modal fade" id="assignDriverModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
