				<div class="callout callout-danger" ng-show="serverError==true">
		             <h4>Assigning failed!</h4>
		             <p>{{serverErrorMessage}}</p>
		         </div>
		      <div class="modal-body">
		        <form role="form" id="orderForm">
                <div class="box-body">
					<div class="overlay" ng-show="loading == true">
                 		<i class="fa fa-refresh fa-spin"></i>
               		</div>
					<select class="form-control" ng-model="currentDriver" ng-options="driver.fullName for driver in drivers track by driver.id">
