<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>G2G | Dashboard</title>
    <meta content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no' name='viewport'>
    <!-- Bootstrap 3.3.2 -->
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" />    
    <!-- FontAwesome 4.3.0 -->
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.3.0/css/font-awesome.min.css" rel="stylesheet" type="text/css" />
    <!-- Ionicons 2.0.0 -->
    <link href="http://code.ionicframework.com/ionicons/2.0.0/css/ionicons.min.css" rel="stylesheet" type="text/css" />    
    <!-- Theme style -->
    <link href="/dist/css/AdminLTE.min.css" rel="stylesheet" type="text/css" />
    <!-- AdminLTE Skins. Choose a skin from the css/skins 
         folder instead of downloading all of them to reduce the load. -->
    <link href="/dist/css/skins/_all-skins.min.css" rel="stylesheet" type="text/css" />
    <!-- iCheck -->
    <link href="/plugins/iCheck/flat/blue.css" rel="stylesheet" type="text/css" />
    <!-- Morris chart -->
    <!-- <link href="/plugins/morris/morris.css" rel="stylesheet" type="text/css" /> -->
    <!-- jvectormap -->
    <!-- <link href="/plugins/jvectormap/jquery-jvectormap-1.2.2.css" rel="stylesheet" type="text/css" /> -->
    <!-- Date Picker -->
    <link href="/plugins/datepicker/datepicker3.css" rel="stylesheet" type="text/css" />
    <!-- Daterange picker -->
    <link href="/plugins/daterangepicker/daterangepicker-bs3.css" rel="stylesheet" type="text/css" />
    <!-- bootstrap wysihtml5 - text editor -->
    <link href="/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.min.css" rel="stylesheet" type="text/css" />

	<!-- g2g stylesheet -->
    <link href="/g2g/css/g2g.css" rel="stylesheet" type="text/css" />
    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
        <script src="https://oss.maxcdn.com/libs/respond.js/1.3.0/respond.min.js"></script>
    <![endif]-->
    
    <!-- Google maps -->
	<script src="https://maps.googleapis.com/maps/api/js"></script>
  </head>
  <body ng-app="G2GControlCenterApplication" class="skin-blue">
    <div class="wrapper">
      
      <header class="main-header">
        <% include ../partials/header %>
      </header>
      
      <!-- Left side column. contains the logo and sidebar -->
      <aside class="main-sidebar">
       <% include ../partials/side %>
      </aside>

      <!-- Contains the navbar and content of the page -->
      <div class="content-wrapper" ng-controller="HomePageContentController">
        <!-- Content Header (Page header) -->
        <section class="content-header">
          <h1>
            G2G Dashboard
            <small>Control panel</small>
          </h1>
          <ol class="breadcrumb">
            <li><a href="#"><i class="fa fa-dashboard"></i> Home</a></li>
            <li class="active">G2G Dashboard</li>
          </ol>
        </section>

        <!-- Main content -->
        <section class="content">
          <!-- Small boxes (Stat box) -->
          <div class="row">
            <div class="col-lg-3 col-xs-6">
              <!-- small box -->
              <div class="small-box bg-info" ng-show="newOrdersCount==0">
                <div class="inner">
                  <h3 ng-bind="newOrdersCount">0</h3>
                  <p>New Orders</p>
                </div>
                <div class="icon">
                  <i class="ion-ios-bell-outline" ng-show="refreshingNewOrdersCount==false"></i>
                  <i class="fa fa-refresh fa-spin" ng-show="refreshingNewOrdersCount==true"></i>
                </div>
                <a href="#" class="small-box-footer" ng-click="refreshNewOrders()">View All <i class="fa fa-arrow-circle-right"></i></a>
              </div>
              <div class="small-box bg-red" ng-show="newOrdersCount!=0">
                <div class="inner">
                  <h3 ng-bind="newOrdersCount">0</h3>
                  <p>New Orders</p>
                </div>
                <div class="icon">
                  <i class="ion-ios-bell-outline" ng-show="refreshingNewOrdersCount==false"></i>
                  <i class="fa fa-refresh fa-spin" ng-show="refreshingNewOrdersCount==true"></i>
                </div>
                <a href="#" class="small-box-footer" ng-click="refreshNewOrders()">View All <i class="fa fa-arrow-circle-right"></i></a>
              </div>
            </div><!-- ./col -->
            <div class="col-lg-3 col-xs-6">
              <!-- small box -->
              <div class="small-box bg-yellow">
                <div class="inner">
                  <h3 ng-bind="inProgressOrdersCount">0<!-- <sup style="font-size: 20px">%</sup> --></h3>
                  <p>In Progress Orders</p>
                </div>
                <div class="icon">
                  <i class="ion-ios-gear-outline" ng-show="refreshingInProgressOrdersCount==false"></i>
                  <i class="fa fa-refresh fa-spin" ng-show="refreshingInProgressOrdersCount==true"></i>
                </div>
                <a href="#" class="small-box-footer" ng-click="refreshInProgressOrders()">View All <i class="fa fa-arrow-circle-right"></i></a>
              </div>
            </div><!-- ./col -->
            <div class="col-lg-3 col-xs-6">
              <!-- small box -->
              <div class="small-box bg-green">
                <div class="inner">
                  <h3 ng-bind="completedOrdersCount">0</h3>
                  <p>Completed Orders</p>
                </div>
                <div class="icon">
                  <i class="ion-ios-checkmark-outline" ng-show="refreshingCompletedOrdersCount==false"></i>
                  <i class="fa fa-refresh fa-spin" ng-show="refreshingCompletedOrdersCount==true"></i>
                </div>
                <a href="#" class="small-box-footer" ng-click="refreshCompletedOrders()">View All <i class="fa fa-arrow-circle-right"></i></a>
              </div>
            </div><!-- ./col -->
            <div class="col-lg-3 col-xs-6">
              <!-- small box -->
              <div class="small-box bg-aqua">
                <div class="inner">
                  <h3 ng-bind="registeredUsersCount.length">0</h3>
                  <p>Registered Customers</p>
                </div>
                <div class="icon">
                  <i class="ion ion-person-add" ng-show="refreshingRegisteredUsersCount==false"></i>
                  <i class="fa fa-refresh fa-spin" ng-show="refreshingRegisteredUsersCount==true"></i>
                </div>
                <a href="customers" class="small-box-footer">View All <i class="fa fa-arrow-circle-right"></i></a>
              </div>
            </div><!-- ./col -->
          </div><!-- /.row -->
          
          
           <div class="nav-tabs-custom">
            <ul class="nav nav-tabs">
              <li class="active"><a href="#driversTab" data-toggle="tab">Available Drivers</a></li>
              <li><a href="#ordersTab" data-toggle="tab">Orders</a></li>
            </ul>
            <div class="tab-content">
              <div class="tab-pane" id="ordersTab">
              	<div class="box box-primary">
                <div class="box-header with-border">
                  <h3 class="box-title">Advanced Search</h3>
                  <div class="box-tools pull-right">
                    <button id="collapseExpandBtn" class="btn btn-box-tool" data-widget="collapse"><i id="collapseExpandIcon" class="fa fa-minus"></i></button>
                  </div>
                </div><!-- /.box-header -->
                <div class="box-body">
                	<div class="row">
	                    <div class="col-xs-4">
	                    <label>Order's Customer Name</label>
	           			<input type="text" placeHolder="Search by Customer Name" class="form-control" id="nameSearchCriterion" ng-model="searchCriteria.customerName"/>
	                    </div>
	                    <div class="col-xs-4">
	                    <label>Order's Customer City</label>
           				<input type="text" placeHolder="Search by Customer City" class="form-control" id="citySearchCriterion" ng-model="searchCriteria.customerCity"/>
	                    </div>
	                    <div class="col-xs-4">
	                    <label>Order's Customer Zip Code</label>
	           			<input type="text" placeHolder="Search by Customer Zip" class="form-control" id="zipSearchCriterion" ng-model="searchCriteria.customerZipCode"/>
	                    </div>
                 	 </div>
                 	 <div class="row">
	                    <div class="col-xs-4">
	                    	<label>Order's Restaurant</label>
           					<select class="form-control" ng-model="searchCriteria.restaurant" ng-options="restaurant.name for restaurant in restaurants track by restaurant.id">
									<option value="0">Select Restaurant</option> 
		                      </select>
	                    </div>
	                    <div class="col-xs-4">
	                    	<label>Order's Driver</label>
           					<select class="form-control" ng-model="searchCriteria.driver" ng-options="driver.fullName for driver in drivers track by driver.id">
									<option value="0"Select Driver></option> 
		                      </select>
	                    </div>
	                    <div class="col-xs-4">
	                    	<label>Order's Status</label>
           					<select class="form-control" ng-model="searchCriteria.status" ng-options="status.name for status in statuses track by status.id">
									<option value="">Select Status</option> 
		                      </select>
           				</div>
                 	 </div>
                 	  
	                 <div class="row">
                    <div class="col-xs-4">
                    	<label>Order's Rating</label>
	                     <select class="form-control" ng-model="searchCriteria.rating" ng-options="rating.name for rating in ratings track by rating.id">
								<option value="">Select Rating</option> 
	                      </select>
                 	</div>
                 	 <div class="col-xs-4">
                 	 		<label>Order Placed Between</label>
                    		<div class="input-group">
                      			<div class="input-group-addon">
                        			<i class="fa fa-clock-o"></i>
                      			</div>
                      			<input type="text" class="form-control pull-right" id="placedTime" placeHolder="Placed within" />
                    		</div><!-- /.input group -->
	                    </div>
	                    <div class="col-xs-2">
	                    <label> </label>
	           			 <div class="checkbox">
	                      <label>
	                        <input type="checkbox" ng-model="searchCriteria.onTime">Show only late orders
	                      </label>
	                    </div>
                    </div>
                    <div class="col-xs-2">
                    	<label> </label>
	           			 <div class="checkbox">
	                      <label>
	                        <input type="checkbox" ng-model="searchCriteria.excludeArchived">Exclude archived orders
	                      </label>
	                    </div>
                    </div>
	                 </div>
	                 <div class="row">
	                 <div class="col-xs-12">
                    	<button class="btn btn-default pull-right" ng-click="searchOrders()">
	           					Search
	           				</button>
	           				<button class="btn btn-default pull-right" ng-click="searchOrdersAndExport()">
	           					Search & Export
	           				</button>
                    </div>
	                 </div>
                
                </div><!-- /.box-body -->
                </div><!-- /.box --> 
                <div class="box box-primary">
                <div class="box-header with-border">
                  <h3 class="box-title">Orders</h3>
                <div class="box-body">
                	<div class="overlay"  ng-show="refreshingOrders == true">
                  		<i class="fa fa-refresh fa-spin"></i>
                	</div>
                <div class="box-body table-responsive no-padding"  ng-show="refreshingOrders == false">
                  <table id="example2" class="table table-bordered table-hover">
                    <thead>
                      <tr>
                        <th>ID</th>
                        <th>Restaurant</th>
                        <th>Customer Name</th>
                        <th>Customer Address</th>
                        <th>No. of Items</th>
                        <th>Order Price</th>
                        <th>Order Status</th>
						<th>Full Details</th>
						<th>SMS Customer</th>
                        <th>Assign Restaurant & Driver</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr ng-repeat="order in currentOrders" ng-show="currentOrders.length != 0">
                        <td ng-bind="order.id">
                        </td>
                        <td ng-bind="order.restaurant.name">
                        </td>
                        <td  ng-bind="order.deliveryFullName">
						</td>
                        <td ng-bind="order.deliveryStreetAddress1">
                        </td>
                        <td  ng-bind="order.itemsCount">
                        </td>
                        <td ng-bind="order.totalValue">
						</td>
                        <td>
                     		<small class="label label-danger" ng-show="order.status=='PLACED'">New</small>
                     		<small class="label label-default cursor" ng-hide="order.status=='PLACED' || order.status=='REFUNDED' || order.status=='DELIVERED_ARCHIVED' || order.status=='REFUNDED_ARCHIVED'" ng-click="markOrderPlaced(order)">Mark New</small>
                     		<small class="label label-warning" ng-show="order.status=='RECEIVED'">Received</small>
                        	<small class="label label-default cursor" ng-hide="order.status=='RECEIVED' || order.status=='REFUNDED' || order.status=='DELIVERED_ARCHIVED' || order.status=='REFUNDED_ARCHIVED'" ng-click="markOrderReceived(order)">Mark Received</small>
                        	<small class="label label-warning" ng-show="order.status=='BEING_PREPARED'">Being Prepared</small>
                        	<small class="label label-default cursor" ng-hide="order.status=='BEING_PREPARED' || order.status=='REFUNDED' || order.status=='DELIVERED_ARCHIVED' || order.status=='REFUNDED_ARCHIVED'" ng-click="markOrderBeingPrepared(order)">Mark Being Prepared</small>
                        	<small class="label label-warning" ng-show="order.status=='PICKED_UP'">Picked Up</small>
                        	<small class="label label-default cursor" ng-hide="order.status=='PICKED_UP' || order.status=='REFUNDED' || order.status=='DELIVERED_ARCHIVED' || order.status=='REFUNDED_ARCHIVED'" ng-click="markOrderPickedUp(order)">Mark Picked Up</small>
                      		<small class="label label-success" ng-show="order.status=='DELIVERED'">Delivered</small>
                      		<small class="label label-default cursor" ng-hide="order.status=='DELIVERED' || order.status=='REFUNDED' || order.status=='DELIVERED_ARCHIVED' || order.status=='REFUNDED_ARCHIVED'" ng-click="markOrderDelivered(order)">Mark Delivered</small>
							<small class="label label-primary" ng-show="order.status=='REFUNDED'">REFUNDED</small>
							
							<small class="label label-default cursor" ng-show="order.status=='DELIVERED' || order.status=='REFUNDED'" ng-click="markOrderArchived(order)">Archive</small>
							<small class="label label-success cursor" ng-show="order.status=='DELIVERED_ARCHIVED'" ng-click="markOrderUnArchived(order)">Delivered & Archived - Un-Archive</small>
							<small class="label label-primary cursor" ng-show="order.status=='REFUNDED_ARCHIVED'" ng-click="markOrderUnArchived(order)">Refunded & Archived - Un-Archive</small>
						</td>
						<td>
							<i class="ion-clipboard cursor" ng-click="openFullDetailsDialog(order.id)"> Full Details</i>
						</td>
						<td>
							<i class="ion-clipboard cursor" ng-click="openSMSCustomer(order)"> SMS Customer</i>
						</td>
						<td>
							<i class="ion-clipboard cursor" ng-click="openUpdateRestaurantAddressDialog(order)"> Assign Restaurant & Driver</i>
						</td>
                      </tr>
                      <tr ng-show="currentOrders.length == 0">
                      	<td colspan="10">
                      		<span class="text">There are no orders matching your selection ...</span>
                      	</td>
                      </tr>
                    </tbody>
                  </table>
                 <!--  <ul class="todo-list">
                    <li ng-repeat="order in currentOrders" ng-show="currentOrders.length != 0">
                      drag handle
                      <span class="handle">
                        <i class="fa fa-ellipsis-v"></i>
                        <i class="fa fa-ellipsis-v"></i>
