	    <!-- Modals -->
    	<div class="modal fade" id="viewMessageModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
		  <div class="modal-dialog">
		    <div class="modal-content">
		      <div class="modal-header">
		        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
		        <h4 class="modal-title" id="sendDriverSMSLabel">View Message</h4>
		      </div>
		      <div class="modal-body">
		        <form role="form" id="smsForm">
                <div class="box-body">
					<label for="source">Source</label>
					<input type="text" class="form-control" id="source" ng-model="currentMessageSource" disabled/>
					<label for="time">Time</label>
					<input type="text" class="form-control" id="time" ng-model="currentMessageTime" disabled/>
					<label for="sms">Message</label>
					<textarea class="form-control" id="messageText" ng-model="currentMessageText" disabled></textarea>
                </div><!-- /.box-body -->
              </form>
		      </div>
		      <div class="modal-footer">
		        <button type="button" class="btn btn-default pull-left" data-dismiss="modal">Close</button>
		        <button type="button" class="btn btn-primary" ng-click="openRespondDialog()">Respond</button>
				<button type="button" class="btn btn-primary" ng-click="markCurrentMessageAsRead()" >Mark as read</button>
		      </div>
		    </div>
		  </div>
		</div>
		
    	<div class="modal fade" id="sendMessageModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
		  <div class="modal-dialog">
		    <div class="modal-content">
		      <div class="modal-header">
		        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
		        <h4 class="modal-title" id="sendDriverSMSLabel">Send SMS</h4>
	      		<div class="overlay pull-right" ng-show="sendingSMS == true">
             		<i class="fa fa-refresh fa-spin"></i>
           		</div>
		      </div>
				<div class="callout callout-danger" ng-show="serverError==true">
		             <h4>Sending SMS failed!</h4>
		             <p>{{serverErrorMessage}}</p>
		         </div>
		         <div class="callout callout-info" ng-show="notification==true">
		             <h4>Notification from G2G!</h4>
		             <p>{{notificationMessage}}</p>
		         </div>
		      <div class="modal-body">
		        <form role="form" id="smsForm">
                <div class="box-body">
					<label for="mobileNumber">Mobile Number</label>
					<input type="text" class="form-control" id="mobileNumber" ng-model="destination"/>
					<label for="sms">SMS</label>
					<textarea class="form-control" id="sms" ng-model="nesSmsText"></textarea>
                </div><!-- /.box-body -->
              </form>
		      </div>
		      <div class="modal-footer">
		        <button type="button" class="btn btn-default pull-left" data-dismiss="modal">Close</button>
				<button type="button" class="btn btn-primary" ng-click="sendSMSToDestination()" >Send</button>
		      </div>
		    </div>
		  </div>
		</div>
    
  </div>
</nav>