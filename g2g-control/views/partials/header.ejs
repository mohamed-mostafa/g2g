      <!-- Messages: style can be found in dropdown.less-->
      <li class="dropdown messages-menu">
        <a href="#" class="dropdown-toggle" data-toggle="dropdown">
          <i class="fa fa-envelope-o"></i>
          <span class="label label-danger" ng-show="userMessages.length > 0" ng-bind="userMessages.length"></span>
        </a>
        <ul class="dropdown-menu">
          <li class="header">You have {{userMessages.length}} G2G user message(s)</li>
          <li>
            <!-- inner menu: contains the actual data -->
            <ul class="menu">
              <li ng-repeat="userMessage in userMessages"><!-- start message -->
                <a href="#" ng-click="viewUserMessage(userMessage)">
                  <h4>
                    User: {{userMessage.userFirstName + " " + userMessage.userLastName}}
                    <small><i class="fa fa-clock-o"></i>{{userMessage.messageTime | date: 'hh:mm'}}</small>
                  </h4>
                  <p data-toggle="tooltip" title="{{userMessage.message}}">{{userMessage.message}}</p>
                </a>
              </li><!-- end message -->
            </ul>
          </li>
          <!-- <li class="footer"><a href="#">See All Messages</a></li> -->
        </ul>
      </li>
