<project name="g2g-control" default="moveToOpenShift" basedir=".">
  <description>
    Copies the resources that should be deployed to Openshift to the dist directory.
	Replaces the required values
  </description>
  <!-- set global properties for this build -->
  <property name="src" location="."/>
  <property name="target" location="../../build/g2g-control/local"/>

  <target name="clean">
    <!-- Create the time stamp -->
    <tstamp/>
	<!-- Delete the ${target} directory tree 
    <delete dir="${target}"/>
	<mkdir dir="${target}"/>-->
  </target>

  <target name="copy" depends="clean" description="Collecting the needed files and copy them to test and prod">
  		<copy todir="${target}/node_modules">
  	    	<fileset dir="${src}/node_modules"/>
  	  	</copy>
  		<copy todir="${target}/static">
  	    	<fileset dir="${src}/static"/>
  	  	</copy>
	  	<copy todir="${target}/views">
  	    	<fileset dir="${src}/views"/>
  	  	</copy>
		<copy todir="${target}">
  	    	<fileset file="${src}/server.js"/>
  	  	</copy>
  		<copy todir="${target}">
  	    	<fileset file="${src}/package.json"/>
  	  	</copy>
  </target>
    	
	<target name="replace" depends="copy" description="Replacing the dynamic values">
  		<replace file="${target}/static/g2g/js/G2GControlCenterApplication.js" token="#G2G_BACKEND_SERVER_URL#" value="http://localhost:8080" summary="yes"></replace>
  </target>

  <target name="moveToOpenShift" depends="replace" description="Copies the files to openshift's local repository, to be pushed manually">
  </target>

</project>