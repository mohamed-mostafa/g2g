<project name="g2g-control" default="package" basedir=".">
  <description>
    Copies the resources that should be deployed to Openshift to the dist directory.
	Replaces the required values
  </description>
  <!-- set global properties for this build -->
  <property name="src" location="."/>
  <property name="target" location="../../build/g2g-customer/prod"/>

  <target name="clean">
    <!-- Create the time stamp -->
    <tstamp/>
	<!-- Delete the ${target} directory tree -->
    <delete dir="${target}"/>
	<mkdir dir="${target}"/>
  </target>

  <target name="copy" depends="clean" description="Collecting the needed files and copy them to test and prod">
  		<copy todir="${target}">
	    	<fileset dir="${src}" excludes="prod/ local/ test/ local_android/ *.ant"/>
	  	</copy>
  </target>
    	
  <target name="replace" depends="copy" description="Replacing the dynamic values">
  		<replace file="${target}/www/js/globals.js" token="#G2G_BACKEND_SERVER_URL#" value="http://services.g2gapp.net" summary="yes"></replace>
		<replace file="${target}/www/js/globals.js" token="#STRIPE_PUBLISHABLE_KEY#" value="pk_live_z6C4fIsyAPSI4nvqxCiDGbkh" summary="yes"></replace>
  	
  	<replace file="${target}/www/js/g2g/libraries/PushNotificationsManager.js" token="#GOOGLE_PROJECT_NUMBER#" value="22861597757" summary="yes"></replace>
	<replace file="${target}/www/js/g2g/libraries/PushNotificationsManager.js" token="#ONE_SIGNAL_APP_ID#" value="b3c9077a-6461-437c-b1ef-8073724a7606" summary="yes"></replace>
  </target>
	
   <target name="package" depends="replace" description="Creates a zip file">
   		<zip destfile="${target}/g2g-customer.zip" basedir="${target}/www"></zip>
  </target>

</project>